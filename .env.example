# Copy this file to .env and fill in real values.
# Vite only exposes variables prefixed with VITE_ to browser code — everything
# else here stays server-only (see src/lib/supabase/server.ts).

# --- Supabase (Phase 2) ---------------------------------------------------
# Project Settings → API in your Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Service role key. NEVER prefix this with VITE_ — it bypasses Row Level
# Security and must only ever be read by server code.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (Phase 3 — not wired up yet) --------------------------------
# VITE_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
